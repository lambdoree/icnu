(module
  (import ic-lib icnu-lib unit)
  (par
    (node two A lit/num 2)
    (node forty A lit/num 40)
    (node add1 A prim/add)
    (node cx C)
    (node cy C)
    (wire (two p) (cx p))
    (wire (forty p) (cy p))
    (wire (cx l) (add1 l))
    (wire (cy l) (add1 r))

    (node three A lit/num 3)
    (node cond A)
    (call ICNU_LT_CONST 2 (three p) cond) ;; 2 < 3 => true

    (node tval A lit/num 100)
    (node eval A lit/num 200)
    (node chosen A)
    (call ICNU_IF (cond p) (tval p) (eval p) chosen)

    (node out A)
    (wire (add1 p) (out p))))
