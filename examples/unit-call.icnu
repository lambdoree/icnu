(par
  (node add-one C)
  (par
    (node in-pack-1 C)
    (wire (add-one-frame-pair-fst-c l) (in-pack-1 p))
    (node out-pack-2 C)
    (wire (add-one-frame-pair-snd-c l) (out-pack-2 p))
    (wire (in-pack-1 l) (ret-3 p))
    (node ret-3 C))
  (wire (ret-3 l) (add-one p))
  (par
    (node v7 A)
    (par
      (node nil2 A ds/nil)
      (node e_4 E)
      (node e_5 E)
      (wire (nil2 l) (e_4 p))
      (wire (nil2 r) (e_5 p)))
    (node result C)
    (wire (add-one l) (result p))
    (node in-copy-6 C)
    (wire (v7 p) (in-copy-6 p))
    (node add-one-frame C)
    (node add-one-frame-pair-fst-c C)
    (node add-one-frame-pair-snd-c C)
    (node add-one-frame-pair-merge-c C)
    (wire (in-copy-6 l) (add-one-frame-pair-fst-c p))
    (wire (nil2 p) (add-one-frame-pair-snd-c p))
    (wire (add-one-frame-pair-fst-c r) (add-one-frame-pair-merge-c l))
    (wire (add-one-frame-pair-snd-c r) (add-one-frame-pair-merge-c r))
    (wire (add-one-frame-pair-merge-c p) (add-one r))))
